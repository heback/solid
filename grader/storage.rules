rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'heback@ts.hs.kr';
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'heback@ts.hs.kr'
        && request.resource.size < 400 * 1024
        && request.resource.contentType == 'application/json';
    }
  }
}
